# Paths and delivery limits
DB_PATH=state/trendyol.db
OUTPUT_DIR=out
OUTPUT_PATH=out/TRENDYOL_SKU_DATA.csv
PRODUCT_TARGET=1000000
# 0 disables category balancing; when enabled this counts products, not SKUs.
CATEGORY_PRODUCT_CAP=0
# Page TRY prices are converted with this reproducible FX snapshot, then only
# values strictly greater than MIN_SELLING_PRICE_USD are stored as USD.
MIN_SELLING_PRICE_USD=20
TRY_PER_USD=48.066
FX_RATE_AS_OF=2026-08-21
EXCLUDED_CATEGORY_TERMS='mücevher|takı|jewelry|jewellery'

# Dispatcher and worker sizing
CONCURRENCY=256
BYPASS_CONCURRENCY=2
CLAIM_BATCH=1024
LEASE_SECONDS=180
REQUEST_TIMEOUT=45
MAX_ATTEMPTS=6
RETRY_BASE_SECONDS=15

# Progressive sitemap/listing-page discovery
PENDING_LOW_WATERMARK=40000
PENDING_QUEUE_TARGET=100000
# Maintain fresh Sitemap/category candidates even when historical queues are full.
FRESH_PENDING_LOW_WATERMARK=10000
FRESH_PENDING_QUEUE_TARGET=40000
SITEMAP_MAX=301

# Sticky proxy. Use either a list or one provider template; the deployed
# Novproxy template selects region-US and randomizes {sid} per worker session.
# Credentials below are placeholders; never commit real values.
PROXY_URLS=
PROXY_TEMPLATE='http://account-region-TR-sid-{sid}:password@proxy.example.com:1000'
# Decimal GB. 0 disables this guard. Reserve covers in-flight requests and
# differences between HTTP-body bytes and the provider's billing meter.
PROXY_TRAFFIC_BUDGET_GB=0
PROXY_STOP_RESERVE_GB=0
STICKY_PAGES=24
STICKY_PAGES_JITTER=8

# Paid bypass is opt-in and only receives explicit challenge pages.
CLOUDBYPASS_ENABLED=false
CLOUDBYPASS_APIKEY=
CLOUDBYPASS_MAX_ATTEMPTS=2
CLOUDBYPASS_MAX_CONCURRENCY=2
CLOUDBYPASS_BUDGET=0

FAILURE_FIXTURE_DIR=state/failures
